            "get_telemetry_history",
            "start_live",
            "stop_live",
            "set_live_quality",
            "switch_camera",
            "get_live_capacity"
          ]
        },
        "research": {
          "model": "cheap",
          "tools": [
            "browser_navigate",
            "browser_navigate_back",
            "browser_snapshot",
            "browser_click",
            "browser_type",
            "browser_fill_form",
            "browser_select_option",
            "browser_press_key",
            "browser_wait_for",
            "browser_tabs",
