        "retry_failed_task",
        "resume_from_breakpoint",
        "takeoff_to_point",
        "set_height_limit",
        "debug_mode",
        "charge_control"
      ],
      "skills": [
        "doc-skills"
      ],
      "subagents": {
        "data-analyst": {
          "model": "cheap",
          "tools": [
            "list_media",
            "get_media_link",
            "list_flight_videos",
            "get_camera_coverage",
            "get_task_report",
            "list_task_history",
            "list_scheduled_tasks",
            "get_schedule_conflicts",
