{
  "deepagents": "0.7.5",
  "projects": {
    "default": {
      "knowledge_scope": "default",
      "locked_tools": [],
      "skills": [
        "doc-skills"
      ],
      "subagents": {
        "doc-writer": {
          "model": "strong",
          "tools": []
        },
        "research": {
          "model": "cheap",
          "tools": [
            "browser_navigate",
            "browser_navigate_back",
            "browser_snapshot",
            "browser_click",
            "browser_type",
            "browser_fill_form",
            "browser_select_option",
            "browser_press_key",
            "browser_wait_for",
            "browser_tabs",
