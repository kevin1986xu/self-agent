# ============ LLM（任意 OpenAI 兼容端点：OpenAI / DashScope / 阿里token plan / vLLM / Ollama…） ============
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_STRONG=qwen3.7-plus
MODEL_CHEAP=qwen3.7-plus

# 可选：按档位覆盖端点/key（混合路由，如强档走另一家、便宜档留 Qwen）
# LLM_BASE_URL_STRONG=https://api.other-provider.com/v1
# LLM_API_KEY_STRONG=sk-yyy
# LLM_BASE_URL_CHEAP=
# LLM_API_KEY_CHEAP=

# 兼容旧命名（等价于 LLM_API_KEY / LLM_BASE_URL，二选一即可）
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=

# ============ 无人机 MCP 服务鉴权（与 mcp-services 一致） ============
UAV_MCP_API_KEY=xxx

# MCP 配置路径（默认 config/mcp_config.json，后续由 Nacos 桥生成）
# MCP_CONFIG_PATH=config/mcp_config.json
